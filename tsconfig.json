{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "Bundler",
    "lib": ["ES2023"], "types": ["node", "react"], "strict": true, "jsx": "react-jsx",
    "skipLibCheck": true, "noEmit": true, "esModuleInterop": true
  },
  "include": ["index.server.ts", "index.client.tsx", "server/**/*.ts", "client/**/*.tsx", "shared/**/*.ts"]
}
